<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="elsnertech_event" resource="default" engine="innodb" comment="Elsnertech Events">
        <column xsi:type="int" name="event_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Event ID"/>
        <column xsi:type="varchar" name="title" nullable="false" length="255" comment="Title"/>
        <column xsi:type="varchar" name="url_key" nullable="false" length="255" comment="URL Key"/>
        <column xsi:type="text" name="short_description" nullable="true" comment="Short Description"/>
        <column xsi:type="text" name="description" nullable="true" comment="Description"/>
        <column xsi:type="varchar" name="venue" nullable="true" length="255" comment="Venue"/>
        <column xsi:type="timestamp" name="start_datetime" nullable="false" comment="Start Datetime"/>
        <column xsi:type="timestamp" name="end_datetime" nullable="true" comment="End Datetime"/>
        <column xsi:type="smallint" name="status" nullable="false" default="1" comment="Status"/>
        <column xsi:type="int" name="sort_order" nullable="false" default="0" comment="Sort Order"/>
        <column xsi:type="varchar" name="meta_title" nullable="true" length="255" comment="Meta Title"/>
        <column xsi:type="text" name="meta_keywords" nullable="true" comment="Meta Keywords"/>
        <column xsi:type="text" name="meta_description" nullable="true" comment="Meta Description"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="false" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="event_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="ELSNERTECH_EVENT_URL_KEY_UNQ">
            <column name="url_key"/>
        </constraint>
        <index referenceId="ELSNERTECH_EVENT_STATUS_START_DT" indexType="btree">
            <column name="status"/>
            <column name="start_datetime"/>
        </index>
    </table>

    <table name="elsnertech_event_store" resource="default" engine="innodb" comment="Elsnertech Event Store Link">
        <column xsi:type="int" name="event_id" padding="10" unsigned="true" nullable="false" comment="Event ID"/>
        <column xsi:type="smallint" name="store_id" padding="5" unsigned="true" nullable="false" comment="Store ID"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="event_id"/>
            <column name="store_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="ELSNERTECH_EVENT_STORE_EVENT_ID_FK"
                    table="elsnertech_event_store" column="event_id"
                    referenceTable="elsnertech_event" referenceColumn="event_id" onDelete="CASCADE"/>
        <constraint xsi:type="foreign" referenceId="ELSNERTECH_EVENT_STORE_STORE_ID_FK"
                    table="elsnertech_event_store" column="store_id"
                    referenceTable="store" referenceColumn="store_id" onDelete="CASCADE"/>
        <index referenceId="ELSNERTECH_EVENT_STORE_STORE_ID" indexType="btree">
            <column name="store_id"/>
        </index>
    </table>

    <table name="elsnertech_event_image" resource="default" engine="innodb" comment="Elsnertech Event Images">
        <column xsi:type="int" name="image_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Image ID"/>
        <column xsi:type="int" name="event_id" padding="10" unsigned="true" nullable="false" comment="Event ID"/>
        <column xsi:type="varchar" name="image" nullable="false" length="255" comment="Image"/>
        <column xsi:type="varchar" name="label" nullable="true" length="255" comment="Label"/>
        <column xsi:type="int" name="position" nullable="false" default="0" comment="Position"/>
        <column xsi:type="smallint" name="disabled" nullable="false" default="0" comment="Disabled"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="image_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="ELSNERTECH_EVENT_IMAGE_EVENT_ID_FK"
                    table="elsnertech_event_image" column="event_id"
                    referenceTable="elsnertech_event" referenceColumn="event_id" onDelete="CASCADE"/>
        <index referenceId="ELSNERTECH_EVENT_IMAGE_EVENT_ID_POSITION" indexType="btree">
            <column name="event_id"/>
            <column name="position"/>
        </index>
    </table>

    <table name="elsnertech_event_store_content" resource="default" engine="innodb" comment="Elsnertech Event Store Content">
        <column xsi:type="int" name="event_id" padding="10" unsigned="true" nullable="false" comment="Event ID"/>
        <column xsi:type="smallint" name="store_id" padding="5" unsigned="true" nullable="false" comment="Store ID"/>
        <column xsi:type="varchar" name="title" nullable="true" length="255" comment="Title Override"/>
        <column xsi:type="text" name="short_description" nullable="true" comment="Short Description Override"/>
        <column xsi:type="text" name="description" nullable="true" comment="Description Override"/>
        <column xsi:type="varchar" name="venue" nullable="true" length="255" comment="Venue Override"/>
        <column xsi:type="varchar" name="meta_title" nullable="true" length="255" comment="Meta Title Override"/>
        <column xsi:type="text" name="meta_keywords" nullable="true" comment="Meta Keywords Override"/>
        <column xsi:type="text" name="meta_description" nullable="true" comment="Meta Description Override"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="event_id"/>
            <column name="store_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="ELSNERTECH_EVENT_STORE_CONTENT_EVENT_ID_FK"
                    table="elsnertech_event_store_content" column="event_id"
                    referenceTable="elsnertech_event" referenceColumn="event_id" onDelete="CASCADE"/>
        <constraint xsi:type="foreign" referenceId="ELSNERTECH_EVENT_STORE_CONTENT_STORE_ID_FK"
                    table="elsnertech_event_store_content" column="store_id"
                    referenceTable="store" referenceColumn="store_id" onDelete="CASCADE"/>
    </table>
</schema>
