<?xml version="1.0" encoding="UTF-8"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">elsnertech_event_form.elsnertech_event_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Event Information</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <buttons>
            <button name="back" class="Elsnertech\Event\Block\Adminhtml\Event\Edit\BackButton"/>
            <button name="delete" class="Elsnertech\Event\Block\Adminhtml\Event\Edit\DeleteButton"/>
            <button name="save" class="Elsnertech\Event\Block\Adminhtml\Event\Edit\SaveButton"/>
            <button name="save_and_continue" class="Elsnertech\Event\Block\Adminhtml\Event\Edit\SaveAndContinueButton"/>
        </buttons>
        <namespace>elsnertech_event_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>elsnertech_event_form.elsnertech_event_form_data_source</dep>
        </deps>
    </settings>
    <dataSource name="elsnertech_event_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="elsnertech_event/event/save"/>
        </settings>
        <dataProvider class="Elsnertech\Event\Model\Event\DataProvider" name="elsnertech_event_form_data_source">
            <settings>
                <requestFieldName>event_id</requestFieldName>
                <primaryFieldName>event_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <fieldset name="general" sortOrder="10">
        <settings>
            <label translate="true">General</label>
        </settings>
        <field name="event_id" formElement="input">
            <settings>
                <visible>false</visible>
                <dataType>text</dataType>
                <dataScope>event_id</dataScope>
            </settings>
        </field>
        <field name="title" sortOrder="10" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Title</label>
                <dataScope>title</dataScope>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <field name="url_key" sortOrder="20" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">URL Key</label>
                <notice translate="true">Leave empty to auto-generate from title.</notice>
                <dataScope>url_key</dataScope>
            </settings>
        </field>
        <field name="status" sortOrder="30" formElement="select">
            <settings>
                <dataType>int</dataType>
                <label translate="true">Status</label>
                <dataScope>status</dataScope>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Elsnertech\Event\Model\Source\Status"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="store_ids" formElement="multiselect" sortOrder="40">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="rawOptions" xsi:type="boolean">true</item>
                </item>
            </argument>
            <settings>
                <label translate="true">Store Views</label>
                <dataScope>store_ids</dataScope>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
            <formElements>
                <multiselect>
                    <settings>
                        <options class="Elsnertech\Event\Model\Source\StoreView"/>
                    </settings>
                </multiselect>
            </formElements>
        </field>
        <field name="sort_order" sortOrder="50" formElement="input">
            <settings>
                <dataType>number</dataType>
                <label translate="true">Sort Order</label>
                <dataScope>sort_order</dataScope>
            </settings>
        </field>
        <field name="content_store_id" sortOrder="60" formElement="select">
            <settings>
                <dataType>int</dataType>
                <label translate="true">Content Scope</label>
                <notice translate="true">Choose default or one store view for content fields in this save.</notice>
                <dataScope>content_store_id</dataScope>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Elsnertech\Event\Model\Source\ContentStore"/>
                    </settings>
                </select>
            </formElements>
        </field>
    </fieldset>
    <fieldset name="schedule" sortOrder="20">
        <settings>
            <label translate="true">Schedule &amp; Venue</label>
        </settings>
        <field name="venue" sortOrder="10" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Venue</label>
                <dataScope>venue</dataScope>
            </settings>
        </field>
        <field name="start_datetime" sortOrder="20" formElement="date">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Start Date/Time</label>
                <dataScope>start_datetime</dataScope>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <field name="end_datetime" sortOrder="30" formElement="date">
            <settings>
                <dataType>text</dataType>
                <label translate="true">End Date/Time</label>
                <dataScope>end_datetime</dataScope>
            </settings>
        </field>
    </fieldset>
    <fieldset name="content" sortOrder="30">
        <settings>
            <label translate="true">Content</label>
        </settings>
        <field name="short_description" sortOrder="10" formElement="textarea">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Short Description</label>
                <dataScope>short_description</dataScope>
            </settings>
        </field>
        <field name="description" template="ui/form/field" sortOrder="20" formElement="wysiwyg">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="wysiwygConfigData" xsi:type="array">
                        <item name="height" xsi:type="string">220px</item>
                        <item name="add_variables" xsi:type="boolean">true</item>
                        <item name="add_widgets" xsi:type="boolean">true</item>
                        <item name="add_images" xsi:type="boolean">true</item>
                        <item name="add_directives" xsi:type="boolean">true</item>
                    </item>
                    <item name="source" xsi:type="string">event</item>
                </item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <label translate="true">Description</label>
                <notice translate="true">Note: Keyboard shortcut to activate editor help : Alt + 0 (Windows) or &#x2325;0 (MacOS)</notice>
                <dataScope>description</dataScope>
            </settings>
            <formElements>
                <wysiwyg>
                    <settings>
                        <wysiwyg>true</wysiwyg>
                    </settings>
                </wysiwyg>
            </formElements>
        </field>
    </fieldset>
    <fieldset name="images_fieldset" sortOrder="40">
        <settings>
            <label translate="true">Gallery Images</label>
        </settings>
        <field name="images" formElement="imageUploader" sortOrder="10">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">elsnertech_event_form</item>
                </item>
            </argument>
            <settings>
                <elementTmpl>ui/form/element/uploader/image</elementTmpl>
                <dataType>string</dataType>
                <label translate="true">Images</label>
            </settings>
            <formElements>
                <imageUploader>
                    <settings>
                        <previewTmpl>Magento_Catalog/image-preview</previewTmpl>
                        <openDialogTitle>Media Gallery</openDialogTitle>
                        <initialMediaGalleryOpenSubpath>elsnertech/event</initialMediaGalleryOpenSubpath>
                        <allowedExtensions>jpg jpeg gif png webp</allowedExtensions>
                        <maxFileSize>4194304</maxFileSize>
                        <isMultipleFiles>true</isMultipleFiles>
                        <uploaderConfig>
                            <param xsi:type="url" name="url" path="elsnertech_event/event/upload"/>
                        </uploaderConfig>
                    </settings>
                </imageUploader>
            </formElements>
        </field>
    </fieldset>
    <fieldset name="seo" sortOrder="50">
        <settings>
            <label translate="true">SEO</label>
        </settings>
        <field name="meta_title" sortOrder="10" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Meta Title</label>
                <dataScope>meta_title</dataScope>
            </settings>
        </field>
        <field name="meta_keywords" sortOrder="20" formElement="textarea">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Meta Keywords</label>
                <dataScope>meta_keywords</dataScope>
            </settings>
        </field>
        <field name="meta_description" sortOrder="30" formElement="textarea">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Meta Description</label>
                <dataScope>meta_description</dataScope>
            </settings>
        </field>
    </fieldset>
</form>
