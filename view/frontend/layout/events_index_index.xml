<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      layout="1column"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <title>Upcoming Events</title>
        <meta name="description" content="Browse our curated collection of upcoming events. Join us for unforgettable experiences."/>
    </head>
    <body>
        <referenceBlock name="page.main.title" remove="true"/>
        <referenceContainer name="content">
            <block class="Elsnertech\Event\Block\EventList"
                   name="elsnertech.event.list"
                   template="Elsnertech_Event::event/list.phtml"/>
        </referenceContainer>
    </body>
</page>
