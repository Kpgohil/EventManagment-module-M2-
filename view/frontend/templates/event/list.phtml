<?php
/**
 * @var \Elsnertech\Event\Block\EventList $block
 */
$events = $block->getEventCollection();
$cardHeight = $block->getCardImageHeight();
$defaultVenue = $block->getDefaultVenueLabel();
?>
<div class="els-event-page">

    <!-- Hero Section -->
    <?php if ($block->isShowHeroEnabled()): ?>
    <div class="els-hero">
        <div class="els-hero__overlay"></div>
        <div class="els-hero__content">
            <span class="els-hero__badge"><?= $block->escapeHtml(__('Upcoming Events')) ?></span>
            <h1 class="els-hero__title"><?= $block->escapeHtml($block->getListingLabel()) ?></h1>
            <p class="els-hero__subtitle"><?= $block->escapeHtml(__('Join us for unforgettable moments. Browse our curated collection of upcoming events.')) ?></p>
        </div>
    </div>

    <?php endif; ?>

    <?php if ($events->getSize()): ?>

        <!-- Events Grid -->
        <div class="els-grid">
            <?php foreach ($events as $event):
                $imgUrl = $block->getFeaturedImage($event);
                $hasImage = $imgUrl !== '';
                $venue = (string)$event->getData('venue');
                if ($venue === '' && $defaultVenue !== '') {
                    $venue = $defaultVenue;
                }
                $desc = $block->truncate((string)$event->getData('short_description'), 130);
            ?>
                <article class="els-card <?= !$hasImage ? 'els-card--no-img' : '' ?>">
                    <a href="<?= $block->escapeUrl($block->getEventUrl((string)$event->getData('url_key'))) ?>" class="els-card__link">

                        <!-- Image Area -->
                        <div class="els-card__img-wrap" <?= $cardHeight !== 220 ? 'style="height:' . $cardHeight . 'px"' : '' ?>>
                            <?php if ($hasImage): ?>
                                <img class="els-card__img"
                                     src="<?= $block->escapeUrl($imgUrl) ?>"
                                     alt="<?= $block->escapeHtml((string)$event->getData('title')) ?>"
                                     loading="lazy">
                            <?php else: ?>
                                <div class="els-card__img-placeholder">
                                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                                        <circle cx="8.5" cy="8.5" r="1.5"/>
                                        <polyline points="21 15 16 10 5 21"/>
                                    </svg>
                                </div>
                            <?php endif; ?>
                            <!-- Date Badge -->
                            <div class="els-card__date">
                                <span class="els-card__date-day"><?= $block->escapeHtml($block->getDay($event->getData('start_datetime'))) ?></span>
                                <span class="els-card__date-month"><?= $block->escapeHtml($block->getMonth($event->getData('start_datetime'))) ?></span>
                            </div>
                        </div>

                        <!-- Card Body -->
                        <div class="els-card__body">
                            <h2 class="els-card__title"><?= $block->escapeHtml((string)$event->getData('title')) ?></h2>

                            <div class="els-card__meta">
                                <?php if ($venue): ?>
                                    <span class="els-card__meta-item els-card__meta-venue">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                                            <circle cx="12" cy="10" r="3"/>
                                        </svg>
                                        <?= $block->escapeHtml($venue) ?>
                                    </span>
                                <?php endif; ?>
                                <span class="els-card__meta-item els-card__meta-time">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <circle cx="12" cy="12" r="10"/>
                                        <polyline points="12 6 12 12 16 14"/>
                                    </svg>
                                    <?= $block->escapeHtml($block->getFormattedDate($event->getData('start_datetime'))) ?>
                                </span>
                            </div>

                            <?php if ($desc): ?>
                                <p class="els-card__desc"><?= $block->escapeHtml($desc) ?></p>
                            <?php endif; ?>

                            <span class="els-card__cta">
                                <?= $block->escapeHtml(__('View Event')) ?>
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="5" y1="12" x2="19" y2="12"/>
                                    <polyline points="12 5 19 12 12 19"/>
                                </svg>
                            </span>
                        </div>
                    </a>
                </article>
            <?php endforeach; ?>
        </div>

        <!-- Pagination -->
        <?php $pagerHtml = $block->getPagerHtml(); ?>
        <?php if ($pagerHtml): ?>
            <div class="els-pager">
                <?= /* @noEscape */ $pagerHtml ?>
            </div>
        <?php endif; ?>

    <?php else: ?>
        <div class="els-empty">
            <div class="els-empty__icon">
                <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                    <line x1="16" y1="2" x2="16" y2="6"/>
                    <line x1="8" y1="2" x2="8" y2="6"/>
                    <line x1="3" y1="10" x2="21" y2="10"/>
                </svg>
            </div>
            <p><?= $block->escapeHtml(__('No upcoming events found.')) ?></p>
            <p class="els-empty__sub"><?= $block->escapeHtml(__('Check back soon for new events.')) ?></p>
        </div>
    <?php endif; ?>
</div>
